# Copiar para /srv/betintel/.env no Pi (chmod 600) e preencher.
# DATABASE_URL, REDIS_URL, NODE_ENV, PORT e TZ são definidos pelo docker-compose.yml do Pi.

# Onde ficam os dados (por agora no cartão SD; mais tarde num SSD USB montado em /srv) e porta local da API (a 3000 está ocupada pelo eWeLink)
BETINTEL_DATA_DIR=/srv/betintel/data
API_HOST_PORT=3100

# Base de dados (palavra-passe NOVA; a antiga está exposta no DEPLOY.md)
POSTGRES_PASSWORD=

# Autenticação (gerar novos: openssl rand -hex 64)
JWT_SECRET=
JWT_REFRESH_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email (recuperação de palavra-passe)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=https://betintel-api.couveflor.site
ALLOWED_ORIGINS=

# Serviços externos
GEMINI_API_KEY=
API_FOOTBALL_KEY=
INTERNAL_ADMIN_KEY=

# Recolha de odds: em casa (IP português) não é preciso proxy.
SCRAPER_HTTP_PROXY=
# Casas ativas no comparador, separadas por vírgulas (ex.: betclic). Vazio = desligado.
ODDS_SOURCES=
# Sidecar da Betano (partilhado pela API e pelo sidecar; gerar com: openssl rand -hex 32). Sem ele o sidecar não arranca.
BETANO_EGRESS_TOKEN=
BETANO_IMPERSONATE=chrome
# Major do browser nos headers: tem de coincidir com o campo "resolved" de `curl -s localhost:8765/ping` (curl_cffi 0.17.0: chrome152).
BETANO_BROWSER_MAJOR=152

# Opcionais
LOG_LEVEL=info
FORCE_SEED=
AI_PARSER=
OPENAI_API_KEY=
OPENAI_TUNED_MODEL_ID=
